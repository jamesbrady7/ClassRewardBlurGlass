import QtQuick

// 多色杂糅渐变填充（弥散渐变 Mesh Gradient）
// scheme: "mint" 薄荷×紫×粉(默认) | "soda" 薄荷苏打
//         "ember" 暖橙红(32) | "lagoon" 青蓝粉(33) | "orchid" 粉紫(34)
//         "azure" 蓝白光心(35) | "mist" 雾面青粉(36) | "dream" 紫蓝幻彩(37)
//         "scarlet" 正红黑晕 | "peacock" 孔雀粉紫 | "marine" 蓝潮薄荷心 | "kaleido" 紫蓝青湖杂糅
//         "crimson" 深红黑晕(黑更大胆) | "aurora" 极光杂糅(黑多+浅色过渡)
Canvas {
    id: root
    property string scheme: "mint"
    property real rad: height / 2
    property bool hovered: false
    property bool pressed: false
    // 浅色面上白字对比不足 → 用深字
    readonly property bool lightFace: scheme === "mint" || scheme === "soda"
                                      || scheme === "azure" || scheme === "mist"
                                      || scheme === "marine" || scheme === "mintblue"

    onSchemeChanged: requestPaint()
    onHoveredChanged: requestPaint()
    onPressedChanged: requestPaint()
    onWidthChanged: requestPaint()
    onHeightChanged: requestPaint()

    function rgbaStr(c, a) {
        return "rgba(" + Math.round(c.r * 255) + "," + Math.round(c.g * 255) + ","
                + Math.round(c.b * 255) + "," + a + ")"
    }

    function roundRectPath(ctx, x, y, w, h, r) {
        ctx.beginPath()
        ctx.moveTo(x + r, y)
        ctx.lineTo(x + w - r, y); ctx.quadraticCurveTo(x + w, y, x + w, y + r)
        ctx.lineTo(x + w, y + h - r); ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h)
        ctx.lineTo(x + r, y + h); ctx.quadraticCurveTo(x, y + h, x, y + h - r)
        ctx.lineTo(x, y + r); ctx.quadraticCurveTo(x, y, x + r, y)
        ctx.closePath()
    }

    // 柔色斑：径向渐变往背景上“晕”一层颜色（弥散感的核心）
    function blob(ctx, x, y, r, color, a) {
        var c = Qt.color(color)
        var g = ctx.createRadialGradient(x, y, 0, x, y, r)
        g.addColorStop(0, rgbaStr(c, a))
        g.addColorStop(1, rgbaStr(c, 0))
        ctx.fillStyle = g
        ctx.fillRect(x - r, y - r, r * 2, r * 2)
    }

    // 各方案调色板：stops=基底对角渐变 [pos, color]；blobs=[x, y, r(×宽), color, a]（比例坐标）
    // eslint 提示：本函数较长，调色时对照方案名定位
    function pal() {
        if (scheme === "soda")
            return {
                stops: [["0", "#9fe6cc"], ["0.45", "#a9d9f6"], ["0.75", "#a3b4f4"], ["1", "#f2c8da"]],
                blobs: [
                    [0.16, 0.02, 0.42, "#c2f2e0", 0.85],   // 薄荷绿
                    [0.88, 0.92, 0.48, "#b9dcfa", 0.85],   // baby 蓝
                    [0.60, 0.16, 0.40, "#b0befa", 0.62],   // 浅蓝带紫
                    [0.34, 1.02, 0.36, "#fad2e2", 0.55],   // 一丝丝微粉
                    [0.05, 0.85, 0.30, "#a8d0f6", 0.45]
                ]
            }
        // 32：暖橙红弥散（暗晕顶部、橙红主体、底部暖橙光）
        if (scheme === "ember")
            return {
                stops: [["0", "#d63c2a"], ["0.55", "#ef5f36"], ["1", "#f4813e"]],
                blobs: [
                    [0.50, -0.15, 0.70, "#3a1030", 0.50],  // 顶部暗晕
                    [0.42, 0.42, 0.52, "#ff5a30", 0.60],   // 橙红主体
                    [0.55, 1.10, 0.48, "#ffb066", 0.70],   // 底部暖橙光
                    [0.90, 0.10, 0.32, "#c83828", 0.50]
                ]
            }
        // 33：青蓝底 + 双粉斑 + 暗色斜带
        if (scheme === "lagoon")
            return {
                stops: [["0", "#9ad4ec"], ["1", "#78c2e4"]],
                blobs: [
                    [0.28, 0.22, 0.36, "#f062b8", 0.78],   // 粉斑 左上
                    [0.72, 0.80, 0.40, "#f468bc", 0.78],   // 粉斑 右下
                    [0.38, 0.78, 0.32, "#123830", 0.52],   // 暗带 下
                    [0.68, 0.18, 0.30, "#123830", 0.50],   // 暗带 上
                    [0.05, 0.05, 0.28, "#c2ecf8", 0.60]    // 亮青角
                ]
            }
        // 34：粉紫（外圈粉晕、中心深紫暗心）
        if (scheme === "orchid")
            return {
                stops: [["0", "#e9a0d0"], ["1", "#a874c8"]],
                blobs: [
                    [0.50, 0.48, 0.58, "#3a1038", 0.62],   // 中心深紫暗心
                    [0.50, -0.18, 0.62, "#f8b8e0", 0.72],  // 顶部粉晕
                    [0.06, 0.55, 0.34, "#f2a8d4", 0.55],
                    [0.94, 0.60, 0.34, "#c888dd", 0.50],
                    [0.50, 1.12, 0.46, "#9060c0", 0.50]    // 底部紫
                ]
            }
        // 35：蓝底 + 中央白青大光晕（深字）
        if (scheme === "azure")
            return {
                stops: [["0", "#5f9df0"], ["1", "#4a7fe0"]],
                blobs: [
                    [0.50, 0.48, 0.58, "#e2f5ff", 0.92],   // 中央白青光心
                    [0.28, 0.06, 0.40, "#9cc8f8", 0.60],
                    [0.04, 0.55, 0.36, "#3a6cc8", 0.55],   // 左缘深蓝
                    [0.96, 0.55, 0.36, "#3a6cc8", 0.55],   // 右缘深蓝
                    [0.50, 1.05, 0.40, "#6aa4f2", 0.50]
                ]
            }
        // 36：雾面冷白（左上暖粉、中部青、右缘蓝紫；深字）
        if (scheme === "mist")
            return {
                stops: [["0", "#f2ede9"], ["0.5", "#ddeef0"], ["1", "#b0bef0"]],
                blobs: [
                    [0.12, 0.12, 0.40, "#f8c8b6", 0.55],   // 暖粉
                    [0.48, 0.62, 0.44, "#a8d8e8", 0.60],   // 青
                    [0.90, 0.45, 0.44, "#6a8ce8", 0.62],   // 蓝紫
                    [0.55, 1.00, 0.40, "#ffffff", 0.70]    // 底部白光
                ]
            }
        // 37：紫蓝幻彩（青→蓝→紫 + 芥末绿微光；外围亮白光晕由 GlassButton 补）
        if (scheme === "dream")
            return {
                stops: [["0", "#58c8d8"], ["0.45", "#6a7ce8"], ["1", "#7a58c8"]],
                blobs: [
                    [0.08, 0.28, 0.40, "#7ce0e0", 0.80],   // 亮青
                    [0.36, 0.32, 0.26, "#d8e8a0", 0.38],   // 芥末绿微光
                    [0.88, 0.78, 0.52, "#5a3aa8", 0.62],   // 深紫
                    [0.96, 0.12, 0.30, "#e88ac8", 0.42],   // 粉边
                    [0.45, 0.95, 0.36, "#4a3aa0", 0.45]
                ]
            }
        // scarlet：正红 + 黑色半圆渐变 + 一点橙红微渐变（参考 32 的正红版）
        if (scheme === "scarlet")
            return {
                stops: [["0", "#e02020"], ["0.5", "#e42c26"], ["1", "#f0503a"]],
                blobs: [
                    [0.50, -0.28, 0.78, "#14060f", 0.72],  // 黑色半圆（顶部压入）
                    [0.74, 0.58, 0.40, "#ff5a20", 0.42],   // 橙红微渐变
                    [0.20, 0.82, 0.34, "#ff6a30", 0.32],
                    [0.50, 1.15, 0.40, "#ff7040", 0.40]    // 底部微暖
                ]
            }
        // peacock：孔雀羽毛斑点——外→内 浅粉→粉→紫→深心，彼此渐变（参考 34）
        if (scheme === "peacock")
            return {
                stops: [["0", "#f8c8e4"], ["1", "#e8aede"]],
                blobs: [
                    [0.50, 0.50, 0.62, "#a868d0", 0.62],   // 紫环
                    [0.50, -0.12, 0.50, "#fbc0e2", 0.60],  // 顶部浅粉晕
                    [0.50, 0.50, 0.46, "#e070c0", 0.58],   // 粉环
                    [0.50, 0.50, 0.32, "#2a0a2e", 0.72],   // 深色斑点（黑紫）
                    [0.50, 1.12, 0.44, "#8a5ab8", 0.50]    // 底部紫
                ]
            }
        // marine：最外浅蓝 → 两端深饱和蓝 → 向内薄荷蓝 → 中偏下一丢丢白光斑（参考 35）
        if (scheme === "marine")
            return {
                stops: [["0", "#4a78d8"], ["0.18", "#82aaec"], ["0.5", "#9fd6e6"],
                        ["0.82", "#82aaec"], ["1", "#4a78d8"]],
                blobs: [
                    [0.50, 0.62, 0.22, "#ffffff", 0.72],   // 中偏下白光斑
                    [0.50, 0.30, 0.36, "#b8ecdc", 0.50],   // 薄荷蓝内晕
                    [0.04, 0.50, 0.30, "#3a64c8", 0.45],   // 两端加深
                    [0.96, 0.50, 0.30, "#3a64c8", 0.45]
                ]
            }
        // kaleido：紫/蓝/蓝紫/湖蓝/青/浅紫交错杂糅 + 小光斑点缀 + 黑只在侧缘偏下（参考 36）
        if (scheme === "kaleido")
            return {
                stops: [["0", "#8a6ae0"], ["0.25", "#6a7ce8"], ["0.5", "#4a8ad8"],
                        ["0.75", "#3ec0d8"], ["1", "#9a7ae8"]],
                blobs: [
                    [0.15, 0.30, 0.34, "#9a6ae8", 0.58],   // 紫
                    [0.42, 0.72, 0.36, "#4890dc", 0.58],   // 湖蓝
                    [0.68, 0.32, 0.32, "#40c8de", 0.58],   // 青
                    [0.90, 0.72, 0.34, "#5a78e8", 0.58],   // 蓝
                    [0.76, 0.12, 0.28, "#c0a8f5", 0.55],   // 浅紫
                    [0.30, 0.18, 0.11, "#eaf6ff", 0.85],   // 小光斑 ×3
                    [0.58, 0.55, 0.09, "#ffffff", 0.80],
                    [0.84, 0.42, 0.08, "#e8f0ff", 0.72],
                    [0.14, 1.10, 0.30, "#141428", 0.55],   // 黑：侧缘偏下
                    [0.86, 1.10, 0.32, "#141428", 0.55]
                ]
            }
        // crimson：正红黑晕增强版——黑色更深、面积更大胆（半圆压过大半）
        if (scheme === "crimson")
            return {
                stops: [["0", "#d81e1e"], ["0.55", "#e63226"], ["1", "#ef4f38"]],
                blobs: [
                    [0.50, -0.30, 0.92, "#0d0510", 0.85],  // 黑色半圆：更大更深
                    [0.80, 0.62, 0.38, "#ff5a20", 0.40],   // 橙红微渐变
                    [0.18, 0.85, 0.32, "#ff6a30", 0.30],
                    [0.50, 1.15, 0.40, "#ff7040", 0.38]
                ]
            }
        // aurora：紫蓝青湖增强版——黑增多、增浅紫/浅蓝/浅青、浅蓝浅青混在两团深色间、去光斑
        if (scheme === "aurora")
            return {
                stops: [["0", "#a48ef2"], ["0.22", "#6a7ce8"], ["0.45", "#4a8ad8"],
                        ["0.68", "#3ec0d8"], ["1", "#8a72e8"]],
                blobs: [
                    [0.10, 1.12, 0.42, "#0e0e20", 0.72],   // 黑：左下
                    [0.55, 1.20, 0.46, "#0e0e20", 0.68],   // 黑：中下（更大）
                    [0.90, 1.10, 0.42, "#0e0e20", 0.72],   // 黑：右下
                    [0.33, 0.92, 0.38, "#6fe0e8", 0.62],   // 浅青：混在两团深色间
                    [0.72, 0.96, 0.40, "#78a8f5", 0.62],   // 浅蓝：混在两团深色间
                    [0.15, 0.20, 0.42, "#b4a2f5", 0.65],   // 浅紫
                    [0.72, 0.32, 0.36, "#7ce0ea", 0.58],   // 浅青
                    [0.45, 0.55, 0.34, "#4890dc", 0.48]    // 湖蓝
                ]
            }
        // mintblue：浅薄荷蓝 × 白 × 紫 × 深紫 杂糅（薄荷蓝，非薄荷绿；中心白斑更透）
        if (scheme === "mintblue")
            return {
                stops: [["0", "#a6dcf2"], ["0.5", "#a9b6f0"], ["1", "#8a66e0"]],  // 浅薄荷蓝→浅紫→紫
                blobs: [
                    [0.18, 0.08, 0.44, "#a8def4", 0.82],   // 浅薄荷蓝
                    [0.50, 0.30, 0.42, "#ffffff", 0.85],   // 白色光斑
                    [0.86, 0.80, 0.46, "#8a66e0", 0.60],   // 紫
                    [0.36, 0.90, 0.38, "#3a1e90", 0.55],   // 深紫
                    [0.74, 0.10, 0.32, "#d8d0ff", 0.50],   // 浅紫白过渡
                    [0.04, 0.05, 0.26, "#eef5ff", 0.62]    // 左上白角
                ]
            }
        // mintblue2：薄荷蓝白紫·强对比·杂糅版——薄荷蓝加量、加薄荷绿与浅紫，深浅交替。
        // 两条关键判断（都是渲染对照试出来的，脑补会走反）：
        //  ① 面压到深紫底 + 白字——浅底叠浅色永远是"浅色叠浅色"，再怎么调亮都拉不开对比；
        //  ② 白要读得出来，必须用**小半径+满 alpha**；半径一大就成白雾、反而更不"白"。
        //  ⚠️ blob 半径按 width 算 → 长条按钮上纵向会铺满整高（实际是"竖条"），
        //     所以色斑用小半径、亮暗交错摆放，才不会糊成一片。参考 kaleido 的做法。
        if (scheme === "mintblue2")
            return {
                stops: [["0", "#a8f0ff"], ["0.14", "#8ee0ff"], ["0.42", "#7a72f2"],
                        ["0.70", "#4a1aa8"], ["1", "#160240"]],
                blobs: [
                    // ── 色斑：中 alpha 才糅得进去、又不糊字 ──
                    [0.06, 0.40, 0.30, "#9ceeff", 0.75],   // 薄荷蓝（左，加量）
                    [0.46, 0.10, 0.22, "#6ee8a8", 0.62],   // 薄荷绿（上中）
                    [0.86, 0.30, 0.22, "#c2b0ff", 0.60],   // 浅紫（右上）
                    [0.62, 0.92, 0.22, "#8fe8ff", 0.45],   // 薄荷蓝（下，与暗斑交错）
                    // ── 小亮点：半径小才读作"亮点" ──
                    [0.07, 0.08, 0.10, "#ffffff", 1.00],   // 白：主高光核
                    [0.29, 0.03, 0.07, "#ffffff", 0.95],   // 白：顶缘第二颗
                    [0.72, 0.06, 0.08, "#d8faff", 0.85],   // 白青：右上跳一点
                    [0.94, 0.62, 0.07, "#e8e0ff", 0.75],   // 白紫：右下跳一点
                    // ── 暗斑：压深色斑之间，做出深浅交替 ──
                    [0.28, 0.72, 0.24, "#2a0a72", 0.45],   // 左下：给图标垫对比
                    [0.74, 0.82, 0.32, "#2a0a72", 0.60],   // 右下主暗块
                    [0.48, 1.20, 0.40, "#120230", 0.76]    // 底部近黑紫
                ]
            }
        // 默认 mint：薄荷 × 紫 × 粉（初版定稿）
        return {
            stops: [["0", "#96dfc4"], ["0.52", "#b0a5f0"], ["1", "#f2adc9"]],
            blobs: [
                [0.18, 0.05, 0.45, "#bdf2d8", 0.85],
                [0.88, 0.95, 0.50, "#f8c2dc", 0.80],
                [0.66, 0.20, 0.40, "#d6ccff", 0.55],
                [0.34, 1.05, 0.36, "#9ed4f0", 0.38]
            ]
        }
    }

    onPaint: {
        var ctx = getContext("2d")
        ctx.reset()
        var w = width, h = height
        if (w < 4 || h < 4) return
        var p = pal()

        roundRectPath(ctx, 0, 0, w, h, rad)
        ctx.clip()

        var g = ctx.createLinearGradient(0, 0, w, h)
        for (var i = 0; i < p.stops.length; i++)
            g.addColorStop(parseFloat(p.stops[i][0]), p.stops[i][1])
        ctx.fillStyle = g
        ctx.fillRect(0, 0, w, h)

        for (var j = 0; j < p.blobs.length; j++) {
            var b = p.blobs[j]
            blob(ctx, w * b[0], h * b[1], w * b[2], b[3], b[4])
        }

        if (pressed)
            ctx.fillStyle = "rgba(45, 45, 85, 0.14)"
        else if (hovered)
            ctx.fillStyle = "rgba(255, 255, 255, 0.17)"
        else
            ctx.fillStyle = "rgba(255, 255, 255, 0)"
        ctx.fillRect(0, 0, w, h)
    }
}
